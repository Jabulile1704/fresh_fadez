# Fresh Fadez API — copy to `.env` and fill in. Never commit `.env`.

# ---------------------------------------------------------------- database ---
# Local Postgres created by `createdb fresh_fadez` (see README).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fresh_fadez?schema=public"

# Only used by `npm test`. The concurrency test writes and deletes rows, so
# point it at a throwaway database — never at DATABASE_URL in production.
# Leave unset and the database-backed tests skip instead of failing.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fresh_fadez_test?schema=public"

# ------------------------------------------------------------------ runtime ---
NODE_ENV=development
PORT=8080
# Comma-separated origins allowed by CORS. "*" allows any, which is fine for a
# mobile app (no cookies, bearer tokens only) but tighten it if a web admin
# panel is ever added.
CORS_ORIGINS=*

# ---------------------------------------------------------------------- auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Two different secrets, so a leaked access token cannot be turned into a
# refresh token.
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters-long
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30

# ------------------------------------------------------------- booking rules ---
# The salon's local timezone as a fixed offset from UTC, in minutes.
# Africa/Johannesburg is UTC+2 all year round — South Africa has no DST — so a
# fixed offset is correct here, not a shortcut.
SALON_UTC_OFFSET_MINUTES=120

# Soonest a client may book from now. Stops someone booking 09:00 at 08:58.
MIN_BOOKING_LEAD_MINUTES=120
# Grid the offered start times sit on. 15 means :00, :15, :30, :45.
SLOT_GRANULARITY_MINUTES=15
# How far ahead the diary is open.
MAX_BOOKING_DAYS_AHEAD=60
# A client may not cancel inside this many hours of the appointment. Staff and
# the owner always can.
CANCELLATION_WINDOW_HOURS=4
